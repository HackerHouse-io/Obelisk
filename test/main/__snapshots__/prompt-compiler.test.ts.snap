  ],
  "contentHash": "2b80ad1de63b1fad9a5bb42a280e380183b39f76c1202207d9fd738c8a37c6e1",
  "runnerArgs": [
    "-p",
    "--system-prompt-file",
    ".claude/SYSTEM.md",
    "--settings",
    ".claude/settings.json",
    "--output-format",
